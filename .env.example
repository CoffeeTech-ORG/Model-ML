# Plantilla de configuración — copiar a .env y rellenar con valores reales.
# El archivo .env NO se versiona (ver .gitignore). Nunca subir tokens al repo.

# Token JWT emitido por el backend .NET/Azure (obligatorio para llamar al backend).
AZURE_JWT_TOKEN=

# Endpoints del backend (opcionales: ya tienen valor por defecto en el código).
# AZURE_RECOMMENDATION_ENDPOINT=https://<host>/api/v1/recommendations
# COFFEETECH_API_BASE_URL=https://<host>/api/v1

# Ventana de telemetría (días) que alimenta las reglas inferenciales/hídricas. Opcional.
# COFFEETECH_WINDOW_DAYS=10

# Scheduler interno: si es 1, el servicio dispara la generación cada N minutos por su cuenta
# (requiere que corra siempre encendido). Apagado por defecto; alternativa: cron/timer externo.
COFFEETECH_SCHEDULER_ENABLED=0
COFFEETECH_SCHEDULER_MINUTES=30

# Recordatorio de laboratorio: cada cuántos días se vuelve a incluir en el payload por
# dispositivo (estado persistido en COFFEETECH_STATE_FILE). Opcionales.
# COFFEETECH_LAB_REMINDER_DAYS=30
# COFFEETECH_STATE_FILE=coffeetech_state.json
